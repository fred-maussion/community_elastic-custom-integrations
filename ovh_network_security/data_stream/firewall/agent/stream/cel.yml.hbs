interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
auth.oauth2:
  client.id: {{client_id}}
  client.secret: {{client_secret}}
  token_url: {{token_url}}
  scopes:
    - all
resource.url: {{url}}
redact:
  fields: ~
program: |-
  state.with(
    request("GET", state.url.trim_right("/") + "/ip").do_request().as(resp,
      (resp.StatusCode == 200) ?
        {
          "events": resp.Body.decode_json().map(ip_block,
            string(ip_block).split("/").join("%2F").as(ip_enc,
              request("GET", state.url.trim_right("/") + "/ip/" + ip_enc + "/firewall").do_request().as(fw,
                (fw.StatusCode == 200) ?
                  fw.Body.decode_json().map(ip_on_firewall,
                    request("GET", state.url.trim_right("/") + "/ip/" + ip_enc + "/firewall/" + string(ip_on_firewall) + "/rule").do_request().as(rl,
                      (rl.StatusCode == 200) ?
                        rl.Body.decode_json().map(seq,
                          request("GET", state.url.trim_right("/") + "/ip/" + ip_enc + "/firewall/" + string(ip_on_firewall) + "/rule/" + string(int(seq))).do_request().as(d,
                            (d.StatusCode == 200) ?
                              {"message": d.Body.decode_json().with({"ip_block": string(ip_block), "ip_on_firewall": string(ip_on_firewall)}).encode_json()}
                            :
                              {
                                "message": {
                                  "error": {
                                    "code": string(d.StatusCode),
                                    "id": string(d.Status),
                                    "message": "GET /ip/.../firewall/.../rule/" + string(int(seq)) + ": " + ((size(d.Body) != 0) ? string(d.Body) : string(d.Status)),
                                  },
                                }.encode_json(),
                              }
                          )
                        )
                      :
                        []
                    )
                  ).flatten()
                :
                  []
              )
            )
          ).flatten(),
          "want_more": false,
        }
      :
        {
          "events": {
            "error": {
              "code": string(resp.StatusCode),
              "id": string(resp.Status),
              "message": "GET /ip: " + ((size(resp.Body) != 0) ? string(resp.Body) : string(resp.Status)),
            },
          },
          "want_more": false,
        }
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
